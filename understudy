#!/bin/sh
# Checkout convenience; installed builds run the Rust executable directly.
set -eu
understudy_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$understudy_root/target/debug/understudy" ]; then
    printf '%s\n' 'Build first with: cargo build' >&2
    exit 1
fi
exec "$understudy_root/target/debug/understudy" "$@"
