#!/bin/sh
# Session start: one short line about Understudy for the agent. Local only,
# quick, and it never fails the session.
understudy=$(command -v understudy 2>/dev/null)
[ -n "$understudy" ] || [ ! -x "$HOME/.local/bin/understudy" ] || understudy="$HOME/.local/bin/understudy"
if [ -z "$understudy" ]; then
	echo "Understudy is not installed. If the person wants GUI testing in a hidden desktop, offer the understudy setup skill."
	exit 0
fi
"$understudy" agents status --brief 2>/dev/null || echo "Understudy is installed; run understudy doctor before using it."
exit 0
